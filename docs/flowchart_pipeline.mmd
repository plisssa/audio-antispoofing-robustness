  classDef dec  fill:#fdf1dd,stroke:#d69a2f,color:#7a4d0c
  classDef sub  fill:#efe9fb,stroke:#7c5cd6,color:#3c2a7a
  classDef skip fill:#f0f1f2,stroke:#9aa0a6,color:#4b5563
  classDef stopn fill:#fdeaea,stroke:#d64545,color:#7a1c1c
  classDef conn fill:#fdf1dd,stroke:#d69a2f,color:#7a4d0c
